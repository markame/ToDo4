<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo.View.ListAtividade"
             Title="ListAtividade"
             >
    <ScrollView>
        <VerticalStackLayout Padding="100" Margin="0,0,0,0" Spacing="20">

            <CollectionView x:Name="listaAtividades">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="White" CornerRadius="10" >
                            <VerticalStackLayout Margin="20,0,20,20" Spacing="20">
                                <HorizontalStackLayout Spacing="10">
                                <Label Text="Nome da Atividade: "/>
                                <Label Text="{Binding Nome}"/>
                            </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                <Label Text="Descrição da Atividade: "/>
                                <Label Text="{Binding Descricao}"/>
                            </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                <Label Text="Data da Atividade: "/>
                                <Label Text ="{Binding DataCriacao}"/>
                            </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Status da Atividade: "/>
                                    <Label Text ="{Binding Status}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>