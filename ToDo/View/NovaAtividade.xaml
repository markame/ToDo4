<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo.View.NovaAtividade"
             Title="NovaAtividade"
             Background="LightGray">
    <ScrollView>
        <VerticalStackLayout Padding="100" Margin="20,0,20,0" Spacing="20">
            <HorizontalStackLayout HorizontalOptions="Start">
                <Label FontSize="Title" TextColor="Black" Text="Nome:"/>
                <Entry x:Name="entNome" WidthRequest="500"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Start">
                <Label FontSize="Title" TextColor="Black" Text="Descrição:"/>
                <Entry x:Name="entDescricao" WidthRequest="500"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Start">
                <Label FontSize="Title" TextColor="Black" Text="Data Criação:"/>
                <DatePicker x:Name="dtData" TextColor="Black" FontSize="Title"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Start">
                <Label FontSize="Title" TextColor="Black" Text="Status:"/>
                <CheckBox x:Name="cbStatus" IsEnabled="True"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                <Button Clicked="capturarAtividade" Text="Salvar atividade"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>